---
import '../styles/site.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Rule from '../components/Rule.astro';

const { title, current, description = 'Alp Bolukbasi — hardware-aware systems engineer, Karlsruhe.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} — alpblkba.dev` : 'alpblkba.dev'}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <div class="shell">
      <img class="plate" src="/images/backdrop.jpg" alt="" aria-hidden="true" />
      <div class="plate-scrim"></div>
      <div class="col">
        <SiteHeader current={current} />
        <Rule weight="divider" inset />
        <div class="section-pad">
          <slot />
        </div>
        <SiteFooter />
      </div>
    </div>
  </body>
</html>

---
/* BurlBackdrop — the plate behind everything: an authored carbon image plus a
   fine monochrome grain pass. Rendered once per page and never re-derived.
   `dim` drops the plate for pages read end to end (long prose, cv).
   Class names predate the carbon retint. */
const { dim = false } = Astro.props;
---

<div class="burl" aria-hidden="true" data-dim={dim ? "" : undefined}>
  <svg width="0" height="0" style="position:absolute">
    <filter id="burlg">
      <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" seed="9"></feTurbulence>
      <feColorMatrix type="saturate" values="0"></feColorMatrix>
    </filter>
  </svg>
  <div class="burl-plate"></div>
  <div class="burl-grain"></div>
</div>

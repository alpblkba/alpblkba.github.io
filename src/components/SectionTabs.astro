---
import { sections } from '../data/site.js';
const { current } = Astro.props;
---

<nav class="tabs">
  {sections.map((s) => (
    <a
      class="tab"
      href={s.href}
      style={`--accent: ${s.color}`}
      aria-current={s.id === current ? 'page' : undefined}
    >{s.label}</a>
  ))}
</nav>

---
const { variant = 'secondary', size = 'md', prefix, href, class: klass = '', ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={["btn", `btn--${variant}`, size === 'sm' && 'btn--sm', klass]}
  {...href ? { href } : {}}
  {...rest}
>
  {prefix && <span class="btn-prefix">{prefix}</span>}
  <span class="btn-label"><slot /></span>
</Tag>

---
import Tag from './Tag.astro';
import TextLink from './TextLink.astro';
const { kicker, name, tags = [], body, href, linkLabel = 'source' } = Astro.props;
---
<div class="row">
  <div class="row-head">
    <span class="row-kicker">[{kicker}]</span>
    <span class="row-name">{name}</span>
    <div class="tags">{tags.map(t => <Tag label={t} />)}</div>
    {href && <TextLink label={linkLabel} href={href} end />}
  </div>
  <p class="row-body">{body}</p>
</div>

---
import SectionTabs from './SectionTabs.astro';
import SysInfo from './SysInfo.astro';
const { current } = Astro.props;
---

<header class="bar">
  <a class="bar-brand" href="/"><span class="bar-chip"></span><span>alpblkba.dev</span></a>
  <div class="bar-mid"><SectionTabs current={current} /></div>
  <div class="bar-right">
    <SysInfo items={[
      { k: 'uptime', v: '5y 2mo', lit: true },
      { k: 'shell', v: 'zsh' },
      { k: 'wm', v: 'i-should-be-writing-my-thesis' }
    ]} />
  </div>
</header>

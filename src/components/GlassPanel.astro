---
/* GlassPanel — smoked glass, hairline neon frame, titlebar. `focused` keeps
   the frame lit; hover lights it in the section hue. */
const {
  title, meta, accent = 'var(--accent-primary)', focused = false,
  flush = false, large = false, area, class: klass = '', ...rest
} = Astro.props;
---

<section
  class:list={["panel", klass]}
  data-focused={focused ? "" : undefined}
  style={`--accent: ${accent}`}
  {...area ? { "data-area": area } : {}}
  {...rest}
>
  {title && (
    <header class="panel-head">
      <span class="panel-dot"></span>
      <span class="panel-title">{title}</span>
      {meta && <span class="panel-meta">{meta}</span>}
      {Astro.slots.has('actions') && <span class="panel-actions"><slot name="actions" /></span>}
    </header>
  )}
  <div class="panel-body" data-flush={flush ? "" : undefined} data-lg={large ? "" : undefined}>
    <slot />
  </div>
</section>

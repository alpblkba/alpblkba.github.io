---
const { role, org, when, where, bullets = [] } = Astro.props;
---
<div class="tl">
  <div class="tl-head">
    <span class="tl-role">{role}</span>
    {org && <span class="tl-org">{org}</span>}
    {when && <span class="tl-when">{when}{where ? ` · ${where}` : ''}</span>}
  </div>
  {bullets.length > 0 && (
    <ul class="tl-bullets">{bullets.map(b => <li><span>{b}</span></li>)}</ul>
  )}
</div>

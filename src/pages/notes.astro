---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import NoteRow from '../components/NoteRow.astro';
import site from '../data/site.js';
---
<BaseLayout title="notes" current="notes">
  <Section code="01" title="Notes">
    <div class="stack">
      {site.notes.map(n => (
        <NoteRow date={n.date} title={n.title} tag={n.tag} href={`/notes/${n.slug}`} />
      ))}
    </div>
  </Section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassPanel from '../components/GlassPanel.astro';
import NoteRow from '../components/NoteRow.astro';
import { notes } from '../data/site.js';
---

<BaseLayout title="notes — alpblkba.dev" section="notes" layout="notes" foot="alpblkba.dev — engineering notes, lab logs, small writeups">
  <GlassPanel
    class="area-hero"
    title="~/notes"
    meta="engineering notes, lab logs, paper notes, and small technical writeups"
    accent="var(--ws-notes)"
    focused
    flush
  >
    {notes.map((n) => <NoteRow date={n.date} title={n.title} href={n.href} tag={n.tag} />)}
  </GlassPanel>
</BaseLayout>

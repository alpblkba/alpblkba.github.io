---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassPanel from '../components/GlassPanel.astro';
import CVEntry from '../components/CVEntry.astro';
import MetaList from '../components/MetaList.astro';
import { cv, contact } from '../data/site.js';
---

<BaseLayout title="cv — Alp Bolukbasi" section="cv" layout="cv" foot="alpblkba.dev — curriculum vitae">
  <GlassPanel class="area-hero" title="~/cv" meta="Alp Bolukbasi" accent="var(--ws-cv)" focused large>
    <p class="hero-lede" style="max-width:var(--measure-prose)">{cv.lead}</p>

    <h6>profile</h6>
    <p class="prose-col">{cv.profile}</p>

    <h6 style="margin-top:34px">experience</h6>
    <div class="cvlist">
      {cv.experience.map((e) => (
        <CVEntry role={e.role} org={e.org} when={e.when} where={e.where} bullets={e.bullets} compact={e.compact} />
      ))}
    </div>

    <h6 style="margin-top:34px">education</h6>
    <div class="cvlist">
      {cv.education.map((e) => (
        <CVEntry role={e.role} org={e.org} when={e.when} where={e.where} bullets={e.bullets} />
      ))}
    </div>

    <h6 style="margin-top:34px">selected projects</h6>
    <div class="cvlist">
      {cv.projects.map((e) => <CVEntry role={e.role} bullets={e.bullets} compact />)}
    </div>
  </GlassPanel>

  <GlassPanel class="area-id" title="~/cv/skills" accent="var(--ws-cv)">
    <div class="skillcol">
      {cv.skills.map(([k, v]) => (
        <div>
          <p class="skill-k">{k}</p>
          <p class="skill-v">{v}</p>
        </div>
      ))}
      <div>
        <p class="skill-k">languages</p>
        <p class="skill-v">{cv.languages}</p>
      </div>
      <div>
        <p class="skill-k">contact</p>
        <MetaList items={contact} />
      </div>
    </div>
  </GlassPanel>
</BaseLayout>

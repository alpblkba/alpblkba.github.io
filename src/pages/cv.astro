---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import TimelineEntry from '../components/TimelineEntry.astro';
import MetaRow from '../components/MetaRow.astro';
import Rule from '../components/Rule.astro';
import site from '../data/site.js';

const cv = site.cv;
---
<BaseLayout title="cv" current="cv">
  <Section code="01" title="Profile">
    <div class="prose"><p>{cv.lead}</p><p>{cv.profile}</p></div>
  </Section>

  <Section code="02" title="Experience">
    <div class="rows">
      {cv.experience.map((e, i) => (
        <>
          {i > 0 && <Rule weight="row" />}
          <TimelineEntry role={e.role} org={e.org} when={e.when} where={e.where} bullets={e.bullets} />
        </>
      ))}
    </div>
  </Section>

  <Section code="03" title="Education">
    <div class="rows">
      {cv.education.map((e, i) => (
        <>
          {i > 0 && <Rule weight="row" />}
          <TimelineEntry role={e.role} org={e.org} when={e.when} where={e.where} bullets={e.bullets} />
        </>
      ))}
    </div>
  </Section>

  <Section code="04" title="Projects">
    <div class="rows">
      {cv.projects.map((e, i) => (
        <>
          {i > 0 && <Rule weight="row" />}
          <TimelineEntry role={e.role} bullets={e.bullets} />
        </>
      ))}
    </div>
  </Section>

  <Section code="05" title="Skills">
    <div class="stack--tight">
      {cv.skills.map(([k, v]) => <MetaRow label={k} value={v} wide />)}
      <MetaRow label="languages" value={cv.languages} wide mono />
    </div>
  </Section>
</BaseLayout>

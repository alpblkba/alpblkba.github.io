---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ProjectRow from '../components/ProjectRow.astro';
import NoteRow from '../components/NoteRow.astro';
import MetaRow from '../components/MetaRow.astro';
import Rule from '../components/Rule.astro';
import site from '../data/site.js';

const featured = site.projectGroups[0].items;
const latest = site.notes.slice(0, 2);
---
<BaseLayout>
  <Section code="01" title="Selected Work">
    <div class="rows">
      {featured.map((p, i) => (
        <>
          {i > 0 && <Rule weight="row" />}
          <ProjectRow kicker={p.kicker} name={p.name} tags={p.tags} body={p.body} href={p.href} />
        </>
      ))}
    </div>
    <div style="margin-top: var(--space-9)"><a class="ghost" href="/projects">all projects</a></div>
  </Section>

  <Section code="02" title="Notes">
    <div class="stack">
      {latest.map(n => <NoteRow date={n.date} title={n.title} tag={n.tag} href={`/notes/${n.slug}`} />)}
    </div>
    <div style="margin-top: var(--space-7)"><a class="ghost" href="/notes">all notes</a></div>
  </Section>

  <Section code="03" title="Elsewhere">
    <div class="stack--tight">
      {site.contact.map(c => <MetaRow label={c.k} value={c.v} href={c.href} mono />)}
    </div>
  </Section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassPanel from '../components/GlassPanel.astro';
import TerminalPrompt from '../components/TerminalPrompt.astro';
import Button from '../components/Button.astro';
import MetaList from '../components/MetaList.astro';
import FactCell from '../components/FactCell.astro';
import NoteRow from '../components/NoteRow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { contact, facts, direction, notes, projectGroups } from '../data/site.js';
---

<BaseLayout title="alpblkba.dev" section="home" layout="home" foot="alpblkba.dev — somewhere between the debugger and the datasheet">
  <GlassPanel class="area-hero" title="alp@kit — whoami" accent="var(--ws-home)" focused large>
    <TerminalPrompt command="whoami" output="Karlsruhe, Germany — M.Sc. Computer Science, KIT" />
    <p class="eyebrow hero-eyebrow" style="margin-top:22px">systems · embedded · computer architecture</p>
    <h1 class="hero-name">Alp O.<br />Bolukbasi</h1>
    <p class="hero-lede">
      I like software that gets close enough to the machine to make abstractions
      nervous — hardware-aware systems work, somewhere between the debugger and
      the datasheet.
    </p>
    <div class="hero-actions">
      <Button variant="primary" prefix="↓" href="/cv">curriculum vitae</Button>
      <Button variant="secondary" href="/projects">projects</Button>
      <Button variant="ghost" href="mailto:hello@alpblkba.dev">hello@alpblkba.dev</Button>
    </div>
  </GlassPanel>

  <GlassPanel class="area-id" title="~/id" accent="var(--ws-about)">
    <div class="stack">
      <div class="portrait">
        <img src="/images/portrait.png" alt="Alp O. Bolukbasi" width="1024" height="1024" />
      </div>
      <MetaList items={contact} />
    </div>
  </GlassPanel>

  <GlassPanel class="area-facts" title="~/facts" meta="scan me" flush>
    <div class="factgrid">
      {facts.map((x) => <FactCell label={x.label} accent={x.accent}>{x.text}</FactCell>)}
    </div>
  </GlassPanel>

  <GlassPanel class="area-dir" title="~/direction" meta="01" accent="var(--ws-projects)">
    <ol class="chain">
      {direction.map((d, i) => (
        <li>
          <span class="chain-n">{String(i + 1).padStart(3, '0')}</span>
          <span class="chain-t">{d}</span>
        </li>
      ))}
    </ol>
  </GlassPanel>

  <GlassPanel class="area-notes" title="~/notes" meta="02" accent="var(--ws-notes)" flush>
    <a slot="actions" href="/notes">all notes →</a>
    {notes.slice(0, 3).map((n) => <NoteRow date={n.date} title={n.title} href={n.href} />)}
  </GlassPanel>

  <GlassPanel class="area-work" title="~/selected-work" meta="03" accent="var(--ws-projects)">
    <a slot="actions" href="/projects">all projects →</a>
    <div class="cards3">
      {projectGroups[0].items.map((p) => (
        <ProjectCard name={p.name} kicker={p.kicker} body={p.body} href={p.href} tags={p.tags} />
      ))}
    </div>
  </GlassPanel>
</BaseLayout>

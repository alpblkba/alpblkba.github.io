---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassPanel from '../components/GlassPanel.astro';
import Tag from '../components/Tag.astro';
import MetaList from '../components/MetaList.astro';
import { about, interests, contact } from '../data/site.js';
---

<BaseLayout title="about — alpblkba.dev" section="about" layout="about" foot="alpblkba.dev — closer to the machine">
  <GlassPanel class="area-hero" title="~/about" accent="var(--ws-about)" focused large>
    <h2>Closer to the machine</h2>
    <div class="prose-col">
      {about.map((p) => <p>{p}</p>)}
    </div>
  </GlassPanel>

  <GlassPanel class="area-id" title="~/interests" accent="var(--ws-about)">
    <div class="stack">
      <div class="portrait">
        <img src="/images/portrait.png" alt="Alp O. Bolukbasi" width="1024" height="1024" />
      </div>
      <div class="tagrow">
        {interests.map((t) => <Tag tone="hardware">{t.toLowerCase()}</Tag>)}
      </div>
    </div>
  </GlassPanel>

  <GlassPanel class="area-facts" title="~/elsewhere" accent="var(--ws-about)">
    <MetaList items={contact} />
  </GlassPanel>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import MetaRow from '../components/MetaRow.astro';
import Tag from '../components/Tag.astro';
import site from '../data/site.js';
---
<BaseLayout title="about" current="about">
  <Section code="01" title="About">
    <div class="prose">{site.about.map(p => <p>{p}</p>)}</div>
  </Section>

  <Section code="02" title="Now">
    <div class="stack--tight">
      {site.facts.map(x => <MetaRow label={x.label} value={x.text} />)}
    </div>
  </Section>

  <Section code="03" title="Interests">
    <div class="tags">{site.interests.map(t => <Tag label={t} />)}</div>
    <div class="stack--tight" style="margin-top: var(--space-7)">
      {site.direction.map((d, i) => (
        <div class="meta-row">
          <span class="meta-key">[{String(i + 1).padStart(2, '0')}]</span>
          <span class="meta-val">{d}</span>
        </div>
      ))}
    </div>
  </Section>
</BaseLayout>

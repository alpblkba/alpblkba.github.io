---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import site from '../data/site.js';
---
<BaseLayout title="music" current="music">
  <Section code="01" title="Sound">
    <div class="prose">{site.music.map(p => <p>{p}</p>)}</div>
  </Section>

  <!-- Keep this section empty until there is something to link. Do not add
       placeholder tracks, embeds or cover art. -->
  <Section code="02" title="Releases">
    <p class="row-body" style="color: var(--text-secondary)">Nothing published yet.</p>
  </Section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassPanel from '../components/GlassPanel.astro';
import Tag from '../components/Tag.astro';
import { music } from '../data/site.js';
---

<BaseLayout title="music — alpblkba.dev" section="music" layout="music" foot="alpblkba.dev — different medium, same instinct">
  <GlassPanel class="area-hero" title="~/music" accent="var(--ws-music)" focused large>
    <h2>Different medium</h2>
    <div class="prose-col">
      {music.map((p) => <p>{p}</p>)}
    </div>
    <div class="tagrow"><Tag tone="music">demo</Tag></div>
  </GlassPanel>
</BaseLayout>

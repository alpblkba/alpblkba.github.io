---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ProjectRow from '../components/ProjectRow.astro';
import Rule from '../components/Rule.astro';
import site from '../data/site.js';
---
<BaseLayout title="projects" current="projects">
  {site.projectGroups.map(g => (
    <Section code={g.num} title={g.title}>
      <div class="rows">
        {g.items.map((p, i) => (
          <>
            {i > 0 && <Rule weight="row" />}
            <ProjectRow kicker={p.kicker} name={p.name} tags={p.tags} body={p.body} href={p.href} />
          </>
        ))}
      </div>
    </Section>
  ))}
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";

const direction = [
  "ops stuff",
  "low level",
  "embedded development",
  "hardware-software co-design",
  "somewhere between debugger and the datasheet",
];

const facts = [
  { label: "now", text: "Student Research Assistant, KIT Chair for Embedded Systems" },
  { label: "study", text: "M.Sc. Computer Science, KIT — since Oct 2025" },
  { label: "before", text: "5+ years in Linux systems, networks and DevOps" },
  { label: "focus", text: "RISC-V, FPGA/HLS, accelerators, hardware security" },
];

const work = [
  { kicker: "verilog · pynq", name: "rv32i-mla", body: "RV32I CPU and accelerator experiments on PYNQ, written in Verilog." },
  { kicker: "fpga · puf", name: "hardware-security", body: "FPGA-based hardware security tasks, PUF experiments, and low-level security concepts." },
  { kicker: "stm32 · c/c++", name: "iot-lab", body: "Embedded systems lab work with STM32, C/C++, UART/GPIO bring-up, and device-level debugging." },
];
---

<BaseLayout title="alpblkba">
  <section class="shell">
    <div class="hero-grid">
      <div class="hero-main">
        <p class="eyebrow">Karlsruhe, Germany — M.Sc. Computer Science, KIT</p>
        <h1 class="display">Alp O.<br />Bolukbasi</h1>
        <p class="kicker-line">systems · embedded · computer architecture · hardware-aware software</p>
        <p class="lede">
          I like software that gets close enough to the machine to make abstractions nervous.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/cv">curriculum vitae</a>
          <a class="btn btn-secondary" href="/projects">projects</a>
          <a class="btn btn-secondary" href="mailto:hello@alpblkba.dev">hello@alpblkba.dev</a>
        </div>
      </div>

      <div class="hero-side">
        <figure>
          <div class="grayscale">
            <img src="/images/portrait.png" alt="Alp O. Bolukbasi" width="1024" height="1024" style="aspect-ratio:1/1;object-fit:cover;width:100%" />
          </div>
          <figcaption>somewhere between the debugger and the datasheet</figcaption>
        </figure>
        <dl class="contact-dl">
          <dt>email</dt><dd><a href="mailto:hello@alpblkba.dev">hello@alpblkba.dev</a></dd>
          <dt>github</dt><dd><a href="https://github.com/alpblkba">alpblkba</a></dd>
          <dt>linkedin</dt><dd><a href="https://www.linkedin.com/in/alpblkba">alpblkba</a></dd>
        </dl>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="factrow">
      {facts.map((f) => (
        <div class="fact">
          <p class="fact-label">{f.label}</p>
          <p>{f.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="sec">
    <div class="sec-grid">
      <div>
        <p class="sec-num">01</p>
        <h2>current direction</h2>
      </div>
      <ol class="chain">
        {direction.map((step, i) => (
          <li>
            <span class="chain-n">{String(i + 1).padStart(3, "0")}</span>
            <span class="chain-t">{step}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sec">
    <div class="sec-grid">
      <div>
        <p class="sec-num">02</p>
        <h2>latest</h2>
        <a class="small-link" href="/notes">all notes &#8594;</a>
      </div>
      <div class="rowlist">
        <a class="rowlink" href="/notes/how-git-could-have-saved-my-friendship">
          <span class="row-date">2026-07-20</span>
          <span class="row-title">How Git Could Have Save My Friendship</span>
          <span class="ra">&#8594;</span>
        </a>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="sec-grid">
      <div>
        <p class="sec-num">03</p>
        <h2>selected work</h2>
        <a class="small-link" href="/projects">all projects &#8594;</a>
      </div>
      <div class="grid3">
        {work.map((w) => (
          <article class="card wcard">
            <p class="card-kicker">{w.kicker}</p>
            <h3 class="card-title">{w.name}</h3>
            <p class="card-body">{w.body}</p>
            <a class="small-link" href="/projects">view projects &#8594;</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

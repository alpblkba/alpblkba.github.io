---
import BaseLayout from "../layouts/BaseLayout.astro";

const notes = [
  {
    title: "How Git Could Have Saved My Friendship",
    date: "2026-07-20",
    href: "/notes/how-git-could-have-saved-my-friendship",
  },
  {
    title: "Correlation Power Analysis on AES with an FPGA Sensor",
    date: "2026-07-15",
    href: "/notes/aes-cpa-on-fpga",
  },
  {
    title: "AES-128 on an iCE40 FPGA",
    date: "2026-07-08",
    href: "/notes/aes-on-hardware",
  },
  {
    title: "SRAM Weak PUF Readout on iCE40",
    date: "2026-06-07",
    href: "/notes/sram-weak-puf-readout",
  },
];
---

<BaseLayout title="notes">
  <div class="shell">
    <div class="page-head page-head-split">
      <h1 class="page-title">notes</h1>
      <p>engineering notes, lab logs, paper notes, and small technical writeups.</p>
    </div>

    <section style="padding:16px 0 72px">
      {notes.map((note) => (
        <a class="rowlink" href={note.href}>
          <span class="row-date">{note.date}</span>
          <span class="row-title">{note.title}</span>
          <span class="ra">&#8594;</span>
        </a>
      ))}
    </section>
  </div>
</BaseLayout>

---
import "../styles/global.css";

const {
  title = "alpblkba",
  description = "Systems, embedded, computer architecture, and hardware-aware software.",
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href) => (path === href ? "page" : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
  </head>

  <body>
    <div class="site">
      <header class="site-header">
        <nav class="nav">
          <a class="nav-brand brand" href="/">
            <span class="brand-dot"></span>
            <span>alpblkba</span>
          </a>
          <a href="/about" aria-current={isCurrent("/about")}>about</a>
          <a href="/projects" aria-current={isCurrent("/projects")}>projects</a>
          <a href="/notes" aria-current={isCurrent("/notes")}>notes</a>
          <a href="/music" aria-current={isCurrent("/music")}>music</a>
          <a href="/cv" aria-current={isCurrent("/cv")}>cv</a>
          <a class="ext" href="https://github.com/alpblkba">github &#8599;</a>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <section class="poster">
        <div class="poster-inner">
          <p>somewhere between the debugger and the datasheet</p>
          <a class="btn" href="mailto:hello@alpblkba.dev">hello@alpblkba.dev</a>
        </div>
      </section>

      <footer class="site-footer">
        <div class="site-footer-inner">
          <span>alpblkba.dev &#8212; built with Astro, deployed with GitHub Pages</span>
          <span class="footer-links">
            <a href="https://github.com/alpblkba">github</a>
            <a href="https://www.linkedin.com/in/alpblkba">linkedin</a>
            <a href="mailto:hello@alpblkba.dev">email</a>
          </span>
        </div>
      </footer>
    </div>
  </body>
</html>
